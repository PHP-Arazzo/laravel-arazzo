{
    "name": "alama/laravel-arazzo",
    "version": "2.0.0-alpha.1",
    "description": "Laravel bridge for alama/arazzo-core: service provider, queue driver, cache lock, Eloquent adapters.",
    "keywords": ["alama", "laravel", "arazzo", "openapi", "workflow"],
    "homepage": "https://github.com/alama/arazzo",
    "license": "MIT",
    "repositories": [
        {"type": "path", "url": "../cli"},
        {"type": "path", "url": "../core"},
        {"type": "path", "url": "../contracts"},
        {"type": "path", "url": "../document"},
        {"type": "path", "url": "../engine"},
        {"type": "path", "url": "../evaluation"},
        {"type": "path", "url": "../expression"},
        {"type": "path", "url": "../protocol-http"},
        {"type": "path", "url": "../protocol-rpc"},
        {"type": "path", "url": "../protocol-soap"},
        {"type": "path", "url": "../runner"},
        {"type": "path", "url": "../sources"}
    ],
    "authors": [
        {"name": "Mohammed Alama", "email": "mohammedalama96@icloud.com", "role": "Developer"}
    ],
    "require": {
        "php": "^8.4",
        "php-arazzo/arazzo-cli": "@dev",
        "php-arazzo/arazzo-core": "@dev",
        "php-arazzo/arazzo-contracts": "@dev",
        "php-arazzo/arazzo-document": "@dev",
        "php-arazzo/arazzo-evaluation": "@dev",
        "php-arazzo/arazzo-expression": "@dev",
        "php-arazzo/arazzo-protocol-http": "@dev",
        "php-arazzo/arazzo-protocol-rpc": "@dev",
        "php-arazzo/arazzo-protocol-soap": "@dev",
        "php-arazzo/arazzo-runner": "@dev",
        "php-arazzo/arazzo-sources": "@dev",
        "guzzlehttp/guzzle": "^7.8||^8.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {"Alama\\Arazzo\\Laravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "Alama\\Arazzo\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alama\\Arazzo\\Laravel\\LaravelArazzoServiceProvider",
                "Alama\\Arazzo\\Laravel\\ProtocolHttpServiceProvider",
                "Alama\\Arazzo\\Laravel\\SoapServiceProvider",
                "Alama\\Arazzo\\Laravel\\RpcServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
