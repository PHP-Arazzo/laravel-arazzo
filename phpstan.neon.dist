includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon
parameters:
    level: max
    paths:
        - src
    excludePaths:
        - tests
    scanDirectories:
        - vendor/php-arazzo/arazzo-core/src
        - vendor/php-arazzo/arazzo-contracts/src
        - vendor/php-arazzo/arazzo-expression/src
        - vendor/php-arazzo/arazzo-document/src
        - vendor/php-arazzo/arazzo-evaluation/src
        - vendor/php-arazzo/arazzo-runner/src
        - vendor/php-arazzo/arazzo-engine/src
        - vendor/php-arazzo/arazzo-cli/src
        - vendor/php-arazzo/arazzo-sources/src
        - vendor/php-arazzo/arazzo-protocol-http/src
        - vendor/php-arazzo/arazzo-protocol-soap/src
        - vendor/php-arazzo/arazzo-protocol-rpc/src
    reportUnmatchedIgnoredErrors: true
